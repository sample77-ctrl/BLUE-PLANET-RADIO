     "x": 420,
     "y": 640
    },
    {
     "at": 1.5,
     "do": "click",
     "text": "/Press play · hear 1880/"
    }
   ]
  },
  "hook-frame": {
   "url": "/frames?frame=eic-ocean-heat",
   "seconds": 16,
   "note": "01 hook: ocean-heat EIC frame sweeping, with its sound",
   "ready": {
    "role": "button",
    "name": "Play",
    "exact": true,
    "settle": 1.5
   },
   "steps": [
    {

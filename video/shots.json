    "settle": 3
   },
   "steps": []
  },
  "about": {
   "url": "/about",
   "seconds": 16,
   "note": "09 science: About the Science, sources and limits",
   "ready": {
    "selector": "main",
    "settle": 2
   },
   "steps": [
    {
     "at": 3,
     "do": "js",
     "value": "(()=>{const e=[...document.querySelectorAll('*')].find(e=>e.scrollHeight>e.clientHeight+300&&/auto|scroll/.test(getComputedStyle(e).overflowY));(e||document.scrollingElement).scrollTo({top:(e||document.scrollingElement).scrollTop+650,behavior:'smooth'})})()"
    },
    {
     "at": 7,
     "do": "js",
     "value": "(()=>{const e=[...document.querySelectorAll('*')].find(e=>e.scrollHeight>e.clientHeight+300&&/auto|scroll/.test(getComputedStyle(e).overflowY));(e||document.scrollingElement).scrollTo({top:(e||document.scrollingElement).scrollTop+650,behavior:'smooth'})})()"
    },
    {
     "at": 11,
     "do": "js",
     "value": "(()=>{const e=[...document.querySelectorAll('*')].find(e=>e.scrollHeight>e.clientHeight+300&&/auto|scroll/.test(getComputedStyle(e).overflowY));(e||document.scrollingElement).scrollTo({top:(e||document.scrollingElement).scrollTop+650,behavior:'smooth'})})()"
    }
   ]

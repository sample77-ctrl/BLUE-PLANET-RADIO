  "jukebox-ab": {
   "url": "/jukebox?story=gistemp&t=1951",
   "seconds": 13,
   "note": "06 data: A 1951-1980 left ear vs B 1996-2025 right ear, half speed; shows the controls then the chart",
   "ready": {
    "text": "/Global temperature since 1880/",
    "settle": 1.5
   },
   "setup": [
    {
     "do": "click",
     "role": "button",
     "name": "Filters",
     "exact": true
    },
    {
     "do": "select",
     "selector": "select",
     "nth": 0,
     "value": "1951"
    },
    {
     "do": "select",
     "selector": "select",
     "nth": 1,
     "value": "1980"
    },
    {
     "do": "press",
     "key": "Escape"
    },
    {
     "do": "check",
     "label": "/Compare two periods/"
    },
    {
     "do": "select",
     "label": "Period B",
     "value": "1996"
    },
    {
     "do": "select",
     "label": "Speed",
     "value": "0.5×"
    },
    {
     "do": "js",
     "value": "(()=>{const c=[...document.querySelectorAll('label')].find(l=>/Compare two periods/.test(l.innerText));c.scrollIntoView({block:'center'})})()"
    }
   ],
   "steps": [
    {
     "at": 0.8,
     "do": "click",
     "role": "button",
     "name": "Play",
     "exact": true
    },
    {
     "at": 3.0,
     "do": "js",
     "value": "window.scrollTo({top:0,behavior:'smooth'})"
    }
   ]
  },
  "jukebox-1998": {
   "url": "/jukebox?story=gistemp&t=1998",
   "seconds": 9,
   "note": "06b data: the 1998 note (0.61 C = A4, 4 pulses), played from 1998 at half speed",
   "ready": {
    "text": "/Global temperature since 1880/",
    "settle": 1.5
   },
   "setup": [
    {
     "do": "select",
     "label": "Speed",
     "value": "0.5×"
    },
    {
     "do": "js",
     "value": "(()=>{const h=[...document.querySelectorAll('h2,h3')].find(e=>/What you hear/.test(e.innerText));window.scrollTo({top:h.getBoundingClientRect().top+scrollY-430,behavior:'smooth'})})()"
    }
   ],
   "steps": [
    {
     "at": 1.0,
     "do": "click",
     "role": "button",
     "name": "Play",
     "exact": true
    }
   ]
  },
